# Local development — copy to .env: cp .env.example .env
#
# Host (npm start):     postgresql://blindpay:blindpay@localhost:5432/blindpay
# Docker Compose sets DATABASE_URL automatically for the backend container.

DATABASE_URL=postgresql://blindpay:blindpay@localhost:5432/blindpay

# 32-byte hex key for AES-256-GCM merchant address encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

PORT=3000

FRONTEND_URL=http://localhost:5173
